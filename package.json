{
  "name": "react-native-localize-date",
  "version": "2.1.1",
  "description": "React Native date localization using correct platform specific preferences",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-localize-date-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "app.plugin.js"
  ],
  "scripts": {
    "example": "npm run --workspace=example",
    "clean": "del-cli lib",
    "prepare": "npm run nitrogen && bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "release": "release-it"
  },
  "keywords": [
    "react-native-localize-date",
    "react-native",
    "nitro",
    "localize",
    "localization",
    "l20n"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jobpaardekooper/react-native-localize-date.git"
  },
  "author": "Job Paardekooper <job@jpsoftware.nl> (https://github.com/jobpaardekooper)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jobpaardekooper/react-native-localize-date/issues"
  },
  "homepage": "https://github.com/jobpaardekooper/react-native-localize-date#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "expo": "~58.0.26",
    "nitrogen": "0.37.2",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-nitro-modules": "0.37.2",
    "release-it": "^21.1.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "expo": ">=58.0.0",
    "react": ">=19.3.0",
    "react-native": ">=0.88.0",
    "react-native-nitro-modules": "^0.37.2"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "npm@11.20.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint",
      "release-it"
    ],
    "version": "0.64.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "release-it": {
    "npm": {
      "publish": true
    },
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireCleanWorkingDir": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "✨ Features"
            },
            {
              "type": "perf",
              "section": "💨 Performance Improvements"
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes"
            },
            {
              "type": "chore(deps)",
              "section": "🛠️ Dependency Upgrades"
            },
            {
              "type": "docs",
              "section": "📚 Documentation"
            }
          ]
        }
      }
    }
  }
}
